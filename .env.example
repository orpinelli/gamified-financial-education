# Banco Supabase/PostgreSQL
# Exemplo (pooler):
# postgresql://postgres.PROJECT_REF:SUA_SENHA@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL="postgresql://postgres.PROJECT_REF:SUA_SENHA@HOST:6543/postgres?sslmode=require"

# Projeto Supabase (frontend)
NEXT_PUBLIC_SUPABASE_URL="https://SEU_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="SEU_ANON_KEY"
# Opcional (novo nome de chave publica)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY="SEU_PUBLISHABLE_KEY"

# Chave para JWT (troque em producao)
JWT_SECRET="troque-por-uma-chave-forte"
